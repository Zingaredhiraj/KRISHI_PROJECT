# Browser calls same-origin /api which Next.js rewrites to the backend.
# Leave NEXT_PUBLIC_API_URL empty on Vercel.
NEXT_PUBLIC_API_URL=

# Server-only backend URL used by next.config.js rewrites.
# Local: http://localhost:8000
# Vercel: https://your-render-service.onrender.com
BACKEND_URL=http://localhost:8000
