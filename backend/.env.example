# Digital Krishi - Backend Environment Variables (Example)
# Copy this to .env and fill in your real values

# ── Database (MySQL) ──────────────────────────────────────────
# For local dev:
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=digital_krishi

# For production (PlanetScale / Railway / Aiven):
# MYSQL_USER=your_cloud_db_user
# MYSQL_PASSWORD=your_cloud_db_password
# MYSQL_HOST=your_cloud_db_host
# MYSQL_PORT=3306
# MYSQL_DATABASE=digital_krishi

# ── Security ──────────────────────────────────────────────────
# IMPORTANT: Change this to a long random string in production!
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-in-production

# ── AI APIs ──────────────────────────────────────────────────
GEMINI_API_KEY=your-google-gemini-api-key-here

# ── CORS Origins (frontend URLs) ──────────────────────────────
# Add your Vercel URL here (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-app.vercel.app

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
